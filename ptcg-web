  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const roomId = urlParams.get('roomId');
    const isHost = urlParams.get('isHost') === 'true';

    document.getElementById('display-room-id').textContent = roomId || '未知';
    document.getElementById('display-role').textContent = isHost ? '房主' : '挑戰者';

    let peer = null, conn = null;
    let savedDecks = [], selectedDeckIndex = -1;

    let playerDeck = [], playerHand = [];
    let fieldCards = {};
    let oppFieldState = {}; // 對手最近一次同步過來的場地（含傷害/狀態），用來單獨更新傷害顯示
    let currentInspectZone = null;
    let draggingCardData = null;

    // 所有會同步給對手的場地區域
    const ALL_SLOTS = ['active', 'active-attached', 'display-front', 'display-back', 'discard', 'lost'];
    for (let i = 0; i < 6; i++) ALL_SLOTS.push(`prize-${i}`);
    for (let i = 0; i < 5; i++) { ALL_SLOTS.push(`bench-${i}`); ALL_SLOTS.push(`bench-${i}-attached`); }

    /* ---------------- 工具函式 ---------------- */

    function placeholderImg(n) {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="150" height="210"><rect width="100%" height="100%" fill="#2e3440"/><text x="50%" y="50%" fill="#fff" font-size="20" text-anchor="middle" dominant-baseline="middle">Card ${n}</text></svg>`;
      return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
    }

    // Fisher–Yates 洗牌（原本的 sort(random) 分布不均）
    function shuffleArray(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // 用 DOM 建立卡牌節點，避免把對手傳來的資料直接塞進 innerHTML（XSS）
    function makeCardNode(card, small) {
      if (card.isFaceDown) {
        const d = document.createElement('div');
        d.className = 'card-back-view';
        if (!small) d.textContent = '背面';
        return d;
      }
      const img = document.createElement('img');
      img.src = card.image || '';
      img.alt = card.name || '';
      return img;
    }

    /* ---------------- P2P 連線 ---------------- */

    function initPeerConnection() {
      if (!roomId) return;

      if (isHost) {
        peer = new Peer(roomId);
        peer.on('open', (id) => {
          appendSystemMessage(`房間已建立！等待對手加入 (ID: ${id})`);
        });
        peer.on('connection', (c) => {
          if (conn && conn.open) { c.close(); return; } // 房間已滿
          conn = c;
          setupConnection();
          appendSystemMessage("對手已成功加入房間！");
        });
      } else {
        peer = new Peer();
        peer.on('open', () => {
          appendSystemMessage(`正在連線至房間：${roomId} ...`);
          conn = peer.connect(roomId, { reliable: true });
          setupConnection();
        });
      }

      peer.on('error', (err) => {
        console.error("PeerJS 錯誤:", err);
        appendSystemMessage(`連線錯誤: ${err.type}`);
      });
    }

    function setupConnection() {
      if (!conn) return;

      const onOpen = () => {
        appendSystemMessage("P2P 連線建立成功！");
        sendFieldState();
      };
      if (conn.open) onOpen(); else conn.on('open', onOpen);

      conn.on('data', handlePeerData);
      conn.on('close', () => appendSystemMessage("對手已斷開連線。"));
      conn.on('error', (e) => appendSystemMessage(`連線錯誤: ${e.type || e}`));
    }

    // 將自己場地狀態同步給對手；背面展示區一律視為背面（即使我方看得到正面）
    function sanitizeCard(c, slot) {
      const hiddenFromOpponent = c.isFaceDown || slot === 'display-back';
      return hiddenFromOpponent ? { isFaceDown: true } : { isFaceDown: false, image: c.image, name: c.name, damage: c.damage || 0, statuses: c.statuses || [] };
    }

    function sendFieldState() {
      if (!conn || !conn.open) return;
      const field = {};
      ALL_SLOTS.forEach(slot => {
        const v = fieldCards[slot];
        if (!v) return;
        if (Array.isArray(v)) { if (v.length) field[slot] = v.map(c => sanitizeCard(c, slot)); }
        else field[slot] = sanitizeCard(v, slot);
      });
      conn.send({ type: 'field_state', field, deckCount: playerDeck.length, handCount: playerHand.length });
    }

    function renderOpponentState(state) {
      clearPointsFor('opp');
      oppFieldState = state.field || {};
      ALL_SLOTS.forEach(slot => {
        const el = document.getElementById(`opp-${slot}`);
        if (el) fillSlot(el, (state.field || {})[slot] || null, slot, false);
      });
      const deckEl = document.getElementById('opp-deck');
      if (deckEl) deckEl.textContent = `牌組 (${state.deckCount ?? 0})`;
      updateOpponentHandUI(state.handCount ?? 0);
    }

    function handlePeerData(data) {
      if (!data) return;

      if (data.type === 'chat') {
        appendChatMessage("對手", String(data.message));
      } else if (data.type === 'hand_update') {
        updateOpponentHandUI(data.count);
      } else if (data.type === 'field_state') {
        renderOpponentState(data);
      } else if (data.type === 'point') {
        const p = data.point;
        points.theirs = p ? { owner: flipOwner(p.owner), slot: p.slot, index: p.index } : null;
        refreshPointGlow();
      } else if (data.type === 'card_moved') {
        appendSystemMessage(`對手移動了卡牌 (${data.fromSlot} ➡️ ${data.toSlot})`);
      } else if (data.type === 'coin_flip') {
        playCoinFlipAnimation('coin-marker-face'); // 硬幣雙方共用同一顆，收到對方的結果也在這顆上播動畫
        appendSystemMessage(`🪙 對手擲了硬幣，結果是：${data.result}`);
      } else if (data.type === 'stadium_place') {
        // 場地區雙方共用：若對方告知「原本那張是你放的」，就把它丟進我自己的棄牌區
        if (data.oldCardOwnedByRecipient && fieldCards['stadium']) {
          if (!Array.isArray(fieldCards['discard'])) fieldCards['discard'] = [];
          fieldCards['discard'].push(fieldCards['stadium']);
          renderSlot('discard');
        }
        fieldCards['stadium'] = { ...data.card, placedByMe: false };
        renderSlot('stadium');
      } else if (data.type === 'damage_update') {
        const c = oppFieldState[data.slot];
        if (c && !Array.isArray(c)) { c.damage = data.damage; c.statuses = data.statuses; }
        renderDamageBars();
      } else if (data.type === 'stadium_clear') {
        fieldCards['stadium'] = null;
        renderSlot('stadium');
      } else if (data.type === 'marker_event') {
        const el = document.getElementById(`opp-${data.marker}-marker-face`);
        if (el) {
          playMarkerFlipAnimation(el);
          el.classList.toggle('used', data.used);
          el.textContent = data.used ? '已使用' : data.marker.toUpperCase();
        }
        appendSystemMessage(data.text);
      }
    }

    /* ---------------- 硬幣／GX／VSTAR 標記 ---------------- */

    function playCoinFlipAnimation(elId = 'coin-marker-face') {
      const el = document.getElementById(elId);
      if (!el) return;
      el.classList.remove('flipping');
      void el.offsetWidth; // 強制 reflow，讓動畫可以重複播放
      el.classList.add('flipping');
      setTimeout(() => el.classList.remove('flipping'), 800);
    }

    function flipCoin() {
      const result = Math.random() < 0.5 ? '正面' : '反面';
      playCoinFlipAnimation('coin-marker-face');
      appendSystemMessage(`🪙 我擲了硬幣，結果是：${result}`);
      if (conn && conn.open) conn.send({ type: 'coin_flip', result });
    }

    let gxUsed = false, vstarUsed = false;

    function playMarkerFlipAnimation(el) {
      el.classList.remove('flip-anim');
      void el.offsetWidth;
      el.classList.add('flip-anim');
      setTimeout(() => el.classList.remove('flip-anim'), 400);
    }

    function toggleGxMarker() {
      const el = document.getElementById('gx-marker-face');
      if (!gxUsed) {
        if (!confirm('您要使用GX力量嗎？')) return;
        gxUsed = true;
      } else {
        gxUsed = false; // 再次點擊可翻回正面（修正誤觸或開新的一局）
      }
      playMarkerFlipAnimation(el);
      el.classList.toggle('used', gxUsed);
      el.textContent = gxUsed ? '已使用' : 'GX';
      const msg = gxUsed ? '我使用了 GX 力量！' : '我把 GX 標記翻回正面。';
      appendSystemMessage(msg);
      if (conn && conn.open) conn.send({
        type: 'marker_event', marker: 'gx', used: gxUsed,
        text: gxUsed ? '對手使用了 GX 力量！' : '對手把 GX 標記翻回正面。'
      });
    }

    function toggleVstarMarker() {
      const el = document.getElementById('vstar-marker-face');
      if (!vstarUsed) {
        if (!confirm('您要使用Vstar力量嗎？')) return;
        vstarUsed = true;
      } else {
        vstarUsed = false;
      }
      playMarkerFlipAnimation(el);
      el.classList.toggle('used', vstarUsed);
      el.textContent = vstarUsed ? '已使用' : 'VSTAR';
      const msg = vstarUsed ? '我使用了 VSTAR 力量！' : '我把 VSTAR 標記翻回正面。';
      appendSystemMessage(msg);
      if (conn && conn.open) conn.send({
        type: 'marker_event', marker: 'vstar', used: vstarUsed,
        text: vstarUsed ? '對手使用了 VSTAR 力量！' : '對手把 VSTAR 標記翻回正面。'
      });
    }

    /* ---------------- IndexedDB (與其他頁面共用卡牌庫) ---------------- */
    function openDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open("ptcg_db", 1);
        req.onupgradeneeded = () => req.result.createObjectStore("cards", { keyPath: "id" });
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }
    async function dbGetAllCards() {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const req = db.transaction("cards", "readonly").objectStore("cards").getAll();
        req.onsuccess = () => resolve(req.result || []);
        req.onerror = () => reject(req.error);
      });
    }

    /* ---------------- 牌組 ---------------- */

    async function initDeckSelection() {
      // 記錄對手區域的預設文字
      document.querySelectorAll('[id^="opp-"]').forEach(el => {
        if (el.dataset.label === undefined) el.dataset.label = el.children.length ? '' : el.textContent.trim();
      });
      document.querySelectorAll('.attached-container').forEach(el => { el.dataset.label = ''; });

      try {
        savedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
        if (!Array.isArray(savedDecks)) savedDecks = [];
      } catch (e) {
        savedDecks = [];
      }

      // 牌組只存 {id, count}，這裡從卡牌庫 (IndexedDB) 補回名稱、圖片等完整資料
      let allCards = [];
      try { allCards = await dbGetAllCards(); } catch (e) { console.error("讀取卡牌庫失敗", e); }
      const cardMap = new Map(allCards.map(c => [c.id, c]));
      savedDecks = savedDecks.map(deck => ({
        ...deck,
        cards: (deck.cards || []).map(item => {
          const full = cardMap.get(item.id) || (item.image ? item : null); // 相容舊版牌組(直接存完整卡牌)
          return full ? { ...full, count: item.count || 1 } : null;
        }).filter(Boolean)
      }));

      const grid = document.getElementById("deckSelectGrid");
      grid.innerHTML = "";

      if (savedDecks.length === 0) {
        const msg = document.createElement('div');
        msg.style.cssText = "grid-column:1/-1; color:#ff4757; text-align:center;";
        msg.textContent = "倉庫無牌組，載入預設卡牌。";
        grid.appendChild(msg);
      } else {
        savedDecks.forEach((deck, index) => {
          const opt = document.createElement("div");
          opt.className = "modal-card";
          opt.onclick = () => {
            document.querySelectorAll("#deckSelectGrid .modal-card").forEach(c => c.classList.remove("selected"));
            opt.classList.add("selected");
            selectedDeckIndex = index;
          };

          const firstCard = Array.isArray(deck.cards) ? deck.cards[0] : null;
          const thumb = document.createElement('div');
          thumb.className = 'modal-card-thumb';
          if (firstCard && firstCard.image) {
            const img = document.createElement('img');
            img.src = firstCard.image;
            img.alt = firstCard.name || '';
            thumb.appendChild(img);
          } else {
            thumb.appendChild(makeCardNode({ isFaceDown: true }, false));
          }
          opt.appendChild(thumb);

          const nameEl = document.createElement('div');
          nameEl.style.cssText = "font-weight:bold; font-size:0.8rem; color:#ffd700; margin-top:4px;";
          nameEl.textContent = deck.name || `牌組 ${index + 1}`;
          opt.appendChild(nameEl);
          grid.appendChild(opt);
        });
      }
      initPeerConnection();
      setupDragAndDrop();
    }

    // 取消牌組選擇：等同離開房間，回到首頁
    function cancelDeckSelection() {
      leaveRoom();
    }

    function confirmDeckSelection() {
      if (savedDecks.length > 0 && selectedDeckIndex < 0) {
        return alert("請先點選一副牌組！");
      }

      let myBattleDeck = [];
      if (selectedDeckIndex >= 0 && savedDecks[selectedDeckIndex]) {
        (savedDecks[selectedDeckIndex].cards || []).forEach(item => {
          for (let i = 0; i < (item.count || 1); i++) {
            myBattleDeck.push({ ...item });
          }
        });
      }
      if (myBattleDeck.length === 0) {
        for (let i = 1; i <= 20; i++) {
          myBattleDeck.push({ id: 'c' + i, name: `寶可夢 ${i}`, image: placeholderImg(i) });
        }
      }

      const stamp = Date.now();
      playerDeck = shuffleArray(myBattleDeck).map((c, index) => ({
        ...c, instanceId: `c_${stamp}_${index}`, isFaceDown: false
      }));

      document.getElementById("deckSelectModal").style.display = "none";
      fieldCards = {};
      renderDamageBars();
      playerHand = playerDeck.splice(0, 7);
      renderPlayerHand();
      updateDeckSlotUI();
      appendSystemMessage(`牌組載入完成（${playerDeck.length + playerHand.length} 張），已抽取 7 張手牌。`);
    }

    function shufflePlayerDeck() {
      playerDeck = shuffleArray(playerDeck);
      updateDeckSlotUI();
      if (currentInspectZone === 'deck') openSideInspectPanel('deck');
      appendSystemMessage("已將牌庫重新洗牌。");
    }

    // 更新牌庫數量並同步給對手（每次狀態變動後都會呼叫）
    function updateDeckSlotUI() {
      clearPointsFor('me');
      document.getElementById("player-deck-slot").textContent = `牌庫 (${playerDeck.length})`;
      sendFieldState();
    }

    function drawCardToHand() {
      if (playerDeck.length === 0) return alert("牌庫已無卡牌！");
      const card = playerDeck.shift();
      card.isFaceDown = false;
      playerHand.push(card);
      renderPlayerHand();
      updateDeckSlotUI();
      appendSystemMessage("抽了一張卡牌至手牌。");
    }

    function drawToDisplay(type) {
      if (playerDeck.length === 0) return alert("牌庫已無卡牌！");
      const card = playerDeck.shift();
      const slotId = type === 'front' ? 'display-front' : 'display-back';
      card.isFaceDown = false; // 我方一律看得到展示區卡牌，背面展示只對「對手」隱藏

      if (!Array.isArray(fieldCards[slotId])) fieldCards[slotId] = [];
      fieldCards[slotId].push(card);

      renderSlot(slotId);
      updateDeckSlotUI();
      appendSystemMessage(`抽了一張牌至${type === 'front' ? '正面' : '背面'}展示區。`);
      if (conn && conn.open) conn.send({ type: 'card_moved', fromSlot: 'deck', toSlot: slotId });
    }

    /* ---------------- 區域檢視 ---------------- */

    function openSideInspectPanel(zoneType) {
      currentInspectZone = zoneType;
      const panel = document.getElementById("sideInspectPanel");
      const grid = document.getElementById("sideInspectGrid");
      const title = document.getElementById("sideInspectTitle");

      panel.style.display = "flex";
      if (panel.scrollIntoView) panel.scrollIntoView({ block: 'nearest' });

      const zoneNames = {
        'deck': '牌庫檢視', 'discard': '棄牌區檢視', 'lost': '放逐區檢視',
        'display-front': '正面展示區檢視', 'display-back': '背面展示區檢視'
      };
      title.textContent = zoneNames[zoneType] || '區域檢視';

      const cardList = (zoneType === 'deck') ? playerDeck : (Array.isArray(fieldCards[zoneType]) ? fieldCards[zoneType] : []);
      grid.innerHTML = "";

      if (cardList.length === 0) {
        const empty = document.createElement('div');
        empty.style.cssText = "grid-column: 1/-1; color: #888; text-align: center; font-size: 0.75rem; margin-top: 20px;";
        empty.textContent = "此區域無卡牌";
        grid.appendChild(empty);
        return;
      }

      cardList.forEach((card, idx) => {
        const item = document.createElement("div");
        item.className = "zone-card-item";

        const imgBox = document.createElement('div');
        imgBox.className = 'zone-card-img';
        imgBox.appendChild(makeCardNode(card, false));
        item.appendChild(imgBox);

        // 從檢視面板直接把任意一張卡拖到場上任何區域
        const innerImg = imgBox.querySelector('img');
        if (innerImg) innerImg.draggable = false;
        item.draggable = true;
        item.addEventListener('dragstart', (e) => startDrag(e, card, zoneType));
        item.addEventListener('dragend', () => { draggingCardData = null; });

        if (card.isFaceDown) {
          const note = document.createElement('div');
          note.style.cssText = "font-size:0.55rem; color:#888;";
          note.textContent = "不可檢視";
          item.appendChild(note);
        } else {
          const actions = document.createElement('div');
          actions.className = 'zone-card-actions';
          // 改用圖示按鈕(原本的「手牌/棄牌/牌庫」文字在窄欄位會被擠到換行，變得很亂)
          [['🤚', 'hand', '加入手牌'], ['🗑️', 'discard', '移至棄牌區'], ['📚', 'deck', '放回牌庫頂']].forEach(([icon, target, title]) => {
            const b = document.createElement('button');
            b.textContent = icon;
            b.title = title;
            b.setAttribute('aria-label', title);
            b.onclick = (e) => { e.stopPropagation(); takeCardFromInspect(zoneType, idx, target); };
            actions.appendChild(b);
          });
          item.appendChild(actions);
        }
        grid.appendChild(item);
      });
    }

    function closeSideInspectPanel() {
      currentInspectZone = null;
      document.getElementById("sideInspectPanel").style.display = "none";
    }

    function takeCardFromInspect(fromZone, index, targetType) {
      let card = null;

      if (fromZone === 'deck') {
        if (index >= 0 && index < playerDeck.length) card = playerDeck.splice(index, 1)[0];
      } else if (Array.isArray(fieldCards[fromZone]) && index >= 0 && index < fieldCards[fromZone].length) {
        card = fieldCards[fromZone].splice(index, 1)[0];
        renderSlot(fromZone);
      }

      if (!card) return;
      card.isFaceDown = false;

      if (targetType === 'hand') {
        playerHand.push(card);
        renderPlayerHand();
        appendSystemMessage("從檢視區拿取一張卡牌至手牌。");
      } else if (targetType === 'discard') {
        if (!Array.isArray(fieldCards['discard'])) fieldCards['discard'] = [];
        fieldCards['discard'].push(card);
        renderSlot('discard');
        appendSystemMessage("將卡牌移至棄牌區。");
      } else if (targetType === 'deck') {
        playerDeck.unshift(card);
        appendSystemMessage("將卡牌放回牌庫最上方。");
      }

      updateDeckSlotUI(); // 同步牌庫數量與場地
      if (currentInspectZone) openSideInspectPanel(currentInspectZone);
    }

    /* ---------------- 拖曳 ---------------- */

    function setupDragAndDrop() {
      document.querySelectorAll('.drop-target').forEach(target => {
        target.addEventListener('dragover', (e) => { e.preventDefault(); target.classList.add('drag-over'); });
        target.addEventListener('dragleave', () => target.classList.remove('drag-over'));
        target.addEventListener('drop', (e) => {
          e.preventDefault();
          target.classList.remove('drag-over');
          if (!draggingCardData) return;

          const { cards, fromSlot, lead, zoomOnly } = draggingCardData;
          draggingCardData = null;
          const toSlot = target.dataset.slot;
          // 放大區：只顯示放大圖，卡牌本身不移動
          if (toSlot === 'zoom') { showInZoomPanel(lead || cards[0]); clearGroupSelection(); return; }
          // 對手的牌只能拿來放大，不能被拖到我方任何區域
          if (zoomOnly) return;
          if (fromSlot === toSlot) { clearGroupSelection(); return; }

          const isMulti = target.dataset.multi === 'true';
          const isSingle = !isMulti && toSlot !== 'hand' && toSlot !== 'deck' && toSlot !== 'deck-top' && toSlot !== 'deck-bottom' && toSlot !== 'stadium';

          // 先檢查目標，避免卡牌從來源移除後卻放不進去而消失
          if (isSingle && (fieldCards[toSlot] || cards.length > 1)) {
            alert(cards.length > 1 ? "此區域一次只能放一張卡，無法整組移入！" : "此區域已有卡牌，請先將原卡牌移開或棄置！");
            clearGroupSelection();
            return;
          }

          // 場地卡一次只能放一張（用「原持有者棄牌」規則處理佔用中的情況，而不是直接擋掉）
          if (toSlot === 'stadium' && cards.length > 1) {
            alert("場地卡一次只能放一張！");
            clearGroupSelection();
            return;
          }

          cards.forEach(card => {
            removeFromSource(card, fromSlot);
            placeCard(card, fromSlot, toSlot, isMulti);
          });
          // 把場地卡直接拖走（不是用新卡替換）時，也要通知對手那邊的場地區跟著清空
          if (fromSlot === 'stadium' && conn && conn.open) conn.send({ type: 'stadium_clear' });
          clearGroupSelection();
        });
      });
      attachGroupContextMenus();
    }

    function removeFromSource(card, fromSlot) {
      if (fromSlot === 'hand') {
        playerHand = playerHand.filter(c => c.instanceId !== card.instanceId);
        renderPlayerHand();
      } else if (fromSlot === 'deck') {
        playerDeck = playerDeck.filter(c => c.instanceId !== card.instanceId);
      } else if (Array.isArray(fieldCards[fromSlot])) {
        fieldCards[fromSlot] = fieldCards[fromSlot].filter(c => c.instanceId !== card.instanceId);
        renderSlot(fromSlot);
      } else {
        delete fieldCards[fromSlot];
        renderSlot(fromSlot);
      }
    }

    function placeCard(card, fromSlot, toSlot, isMulti) {
      card.isFaceDown = toSlot.startsWith('prize');
      // 傷害指示物跟著寶可夢走：離開戰鬥區/備戰區就清掉；從戰鬥區退到備戰區則只保留傷害、特殊狀態解除
      if (!isDamageableSlot(toSlot)) { card.damage = 0; card.statuses = []; }
      else if (toSlot !== 'active') { card.statuses = []; }

      if (toSlot === 'hand') {
        playerHand.push(card);
        renderPlayerHand();
        appendSystemMessage("將卡牌放回手牌。");
      } else if (toSlot === 'deck') {
        card.isFaceDown = false;
        playerDeck.unshift(card);
        appendSystemMessage("將卡牌放回牌庫頂。");
      } else if (toSlot === 'deck-top') {
        card.isFaceDown = false;
        playerDeck.unshift(card);
        appendSystemMessage("將卡牌移至牌庫最上方。");
      } else if (toSlot === 'deck-bottom') {
        card.isFaceDown = false;
        playerDeck.push(card);
        appendSystemMessage("將卡牌移至牌庫最下方。");
      } else if (toSlot === 'stadium') {
        const existing = fieldCards['stadium'];
        let oldCardOwnedByRecipient = false;
        if (existing) {
          if (existing.placedByMe) {
            // 原本場地卡是我放的，直接進我自己的棄牌區
            if (!Array.isArray(fieldCards['discard'])) fieldCards['discard'] = [];
            fieldCards['discard'].push(existing);
            renderSlot('discard');
          } else {
            // 原本場地卡是對手放的，等等請對手自己把它丟進他自己的棄牌區
            oldCardOwnedByRecipient = true;
          }
        }
        card.isFaceDown = false;
        card.placedByMe = true;
        fieldCards['stadium'] = card;
        renderSlot('stadium');
        appendSystemMessage("放置了場地卡。");
        if (conn && conn.open) conn.send({ type: 'stadium_place', card: sanitizeCard(card, 'stadium'), oldCardOwnedByRecipient });
      } else {
        const targetEl = document.querySelector(`[data-slot="${toSlot}"]`);
        if (isMulti) {
          if (!Array.isArray(fieldCards[toSlot])) fieldCards[toSlot] = [];
          fieldCards[toSlot].push(card);
        } else {
          fieldCards[toSlot] = card;
        }
        renderSlot(toSlot);
        appendSystemMessage(`將卡牌移動至 ${(targetEl && targetEl.dataset.label) || '附加區'}。`);
      }

      updateDeckSlotUI(); // 內含 sendFieldState()
      if (conn && conn.open) conn.send({ type: 'card_moved', fromSlot, toSlot });
      if (currentInspectZone) openSideInspectPanel(currentInspectZone);
    }

    /* ---------------- 繪製 ---------------- */

    function renderSlot(slotId) {
      const el = document.querySelector(`[data-slot="${slotId}"]`);
      fillSlot(el, fieldCards[slotId] || null, slotId, true);
    }

    /* ---------------- 指他 ---------------- */

    // points.mine：我指的卡；points.theirs：對手指的卡（owner 皆以「我方視角」表示）
    const points = { mine: null, theirs: null };
    let selectedCard = null;
    const flipOwner = (o) => (o === 'me' ? 'opp' : 'me');

    const pointBtn = document.createElement('button');
    pointBtn.id = 'point-btn';
    pointBtn.textContent = '指他';
    document.body.appendChild(pointBtn);

    function tagPoint(el, owner, slot, index) {
      el.dataset.pOwner = owner;
      el.dataset.pSlot = slot;
      el.dataset.pIndex = index;
    }

    function refreshPointGlow() {
      document.querySelectorAll('.pointed').forEach(el => el.classList.remove('pointed'));
      [points.mine, points.theirs].forEach(p => {
        if (!p) return;
        const el = document.querySelector(`[data-p-owner="${p.owner}"][data-p-slot="${p.slot}"][data-p-index="${p.index}"]`);
        if (el) el.classList.add('pointed');
      });
    }

    function sendPoint(p) {
      if (conn && conn.open) conn.send({ type: 'point', point: p });
    }

    function hidePointBtn() {
      selectedCard = null;
      pointBtn.style.display = 'none';
    }

    function clearMyPoint() {
      hidePointBtn();
      if (points.mine) {
        points.mine = null;
        sendPoint(null);
      }
      refreshPointGlow();
    }

    // 某一方的場地變動後，指向它的標記位置可能已失效，一併清除
    function clearPointsFor(owner) {
      if (points.mine && points.mine.owner === owner) points.mine = null;
      if (points.theirs && points.theirs.owner === owner) points.theirs = null;
      if (selectedCard && selectedCard.owner === owner) hidePointBtn();
      refreshPointGlow();
    }

    function onCardClick(e, owner, slot, index, el) {
      e.__pointHandled = true; // 讓 document 的「點空白處」處理知道這次點到卡牌
      if (points.mine) { points.mine = null; sendPoint(null); refreshPointGlow(); }
      selectedCard = { owner, slot, index };

      const r = el.getBoundingClientRect();
      pointBtn.style.display = 'block';
      const w = pointBtn.offsetWidth || 44;
      let left = r.right + 4;
      if (left + w > window.innerWidth - 4) left = Math.max(4, r.left - w - 4);
      pointBtn.style.left = left + 'px';
      pointBtn.style.top = Math.max(4, r.top + r.height / 2 - pointBtn.offsetHeight / 2) + 'px';
    }

    pointBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!selectedCard) return;
      points.mine = { ...selectedCard };
      sendPoint(points.mine);
      hidePointBtn();
      refreshPointGlow();
    });

    document.addEventListener('click', (e) => {
      if (e.__pointHandled) return;
      clearMyPoint();
    });

    // 統一的拖曳開始處理（Firefox 需要 setData 才會觸發拖曳）
    function startDrag(e, card, fromSlot) {
      let cards = [card];
      if (groupSelection && groupSelection.slotId === fromSlot &&
          groupSelection.ids.has(card.instanceId) && Array.isArray(fieldCards[fromSlot])) {
        cards = fieldCards[fromSlot].filter(c => groupSelection.ids.has(c.instanceId));
      }
      draggingCardData = { cards, fromSlot, lead: card };
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', card.instanceId || 'card');
      }
    }

    /* ---------------- 傷害指示物／特殊狀態 ---------------- */

    const DAMAGEABLE_SLOTS = ['active', 'bench-0', 'bench-1', 'bench-2', 'bench-3', 'bench-4'];
    const isDamageableSlot = (s) => DAMAGEABLE_SLOTS.includes(s);
    const STATUS_DEFS = [
      ['poison', '☠️', '中毒'], ['burn', '🔥', '灼傷'],
      ['asleep', '💤', '睡眠'], ['paralyzed', '⚡', '麻痺'], ['confused', '❓', '混亂']
    ];
    const ROTATION_STATUSES = ['asleep', 'paralyzed', 'confused']; // 這三種同一時間只會有一種

    // 在每個戰鬥區／備戰區的卡牌正下方插入傷害條；戰鬥區再多一排特殊狀態
    function buildDamageBars() {
      ['player', 'opp'].forEach(side => {
        DAMAGEABLE_SLOTS.forEach(slot => {
          const cardEl = document.getElementById(`${side}-${slot}`);
          if (!cardEl) return;
          const bar = document.createElement('div');
          bar.className = 'dmg-bar';
          bar.id = `${side}-${slot}-dmg`;
          if (side === 'player') {
            bar.innerHTML = '<button type="button" class="dmg-minus" title="減少 10 傷害（按住 Shift：50）">−</button>' +
                            '<span class="dmg-val" title="點擊直接輸入傷害">0</span>' +
                            '<button type="button" class="dmg-plus" title="增加 10 傷害（按住 Shift：50）">＋</button>';
            bar.querySelector('.dmg-minus').addEventListener('click', (e) => { e.stopPropagation(); adjustDamage(slot, -1, e.shiftKey); });
            bar.querySelector('.dmg-plus').addEventListener('click', (e) => { e.stopPropagation(); adjustDamage(slot, 1, e.shiftKey); });
            bar.querySelector('.dmg-val').addEventListener('click', (e) => { e.stopPropagation(); promptDamage(slot); });
          } else {
            bar.innerHTML = '<span class="dmg-val">0</span>';
          }
          cardEl.insertAdjacentElement('afterend', bar);

          if (slot === 'active') {
            const sb = document.createElement('div');
            sb.className = 'status-bar';
            sb.id = `${side}-status`;
            STATUS_DEFS.forEach(([key, icon, label]) => {
              const chip = document.createElement('button');
              chip.type = 'button';
              chip.className = 'status-chip';
              chip.dataset.status = key;
              chip.textContent = icon;
              chip.title = label;
              if (side === 'player') chip.addEventListener('click', (e) => { e.stopPropagation(); toggleStatus(key); });
              sb.appendChild(chip);
            });
            bar.insertAdjacentElement('afterend', sb);
          }
        });
      });
    }

    function renderDamageBars() {
      ['player', 'opp'].forEach(side => {
        DAMAGEABLE_SLOTS.forEach(slot => {
          const bar = document.getElementById(`${side}-${slot}-dmg`);
          if (!bar) return;
          const card = side === 'player' ? fieldCards[slot] : oppFieldState[slot];
          const has = !!(card && !Array.isArray(card) && !card.isFaceDown);
          const dmg = has ? (card.damage || 0) : 0;
          bar.classList.toggle('has-card', has);
          bar.classList.toggle('zero', dmg === 0);
          bar.querySelector('.dmg-val').textContent = dmg > 0 ? `💥${dmg}` : '0';
          if (slot === 'active') {
            const sb = document.getElementById(`${side}-status`);
            if (sb) {
              sb.classList.toggle('has-card', has);
              const on = new Set(has ? (card.statuses || []) : []);
              sb.querySelectorAll('.status-chip').forEach(ch => ch.classList.toggle('on', on.has(ch.dataset.status)));
            }
          }
        });
      });
    }

    function afterDamageChange(slot) {
      renderDamageBars();
      const card = fieldCards[slot];
      if (conn && conn.open && card && !Array.isArray(card)) {
        conn.send({ type: 'damage_update', slot, damage: card.damage || 0, statuses: card.statuses || [] });
      }
    }

    function adjustDamage(slot, sign, big) {
      const card = fieldCards[slot];
      if (!card || Array.isArray(card)) return;
      card.damage = Math.max(0, Math.min(990, (card.damage || 0) + sign * (big ? 50 : 10)));
      afterDamageChange(slot);
    }

    function promptDamage(slot) {
      const card = fieldCards[slot];
      if (!card || Array.isArray(card)) return;
      const input = prompt('請輸入這隻寶可夢目前的傷害（10 的倍數）：', String(card.damage || 0));
      if (input === null) return;
      const n = parseInt(input, 10);
      if (Number.isNaN(n)) return;
      card.damage = Math.max(0, Math.min(990, Math.round(n / 10) * 10));
      afterDamageChange(slot);
    }

    function toggleStatus(status) {
      const card = fieldCards['active'];
      if (!card || Array.isArray(card)) return;
      const set = new Set(card.statuses || []);
      if (set.has(status)) {
        set.delete(status);
      } else {
        if (ROTATION_STATUSES.includes(status)) ROTATION_STATUSES.forEach(r => set.delete(r)); // 睡眠/麻痺/混亂互斥
        set.add(status);
      }
      card.statuses = [...set];
      afterDamageChange('active');
    }

    buildDamageBars();

    /* ---------------- 放大區 ---------------- */

    function showInZoomPanel(card) {
      if (!card) return;
      if (card.isFaceDown || !card.image) { appendSystemMessage('背面的卡牌無法放大。'); return; }
      document.getElementById('zoomPanelImg').src = card.image;
      document.getElementById('zoomPanelImg').alt = card.name || '';
      document.getElementById('zoomPanelName').textContent = card.name || '';
      document.getElementById('zoom-panel').classList.add('has-card');
    }

    function clearZoomPanel() {
      document.getElementById('zoom-panel').classList.remove('has-card');
      document.getElementById('zoomPanelImg').removeAttribute('src');
    }

    // 對手場上的（正面）卡牌：只能拖去放大區放大，不能移動
    function enableZoomOnlyDrag(el, card, slotId) {
      if (!card || card.isFaceDown) return;
      el.draggable = true;
      el.addEventListener('dragstart', (e) => {
        draggingCardData = { cards: [card], fromSlot: 'opp-' + slotId, lead: card, zoomOnly: true };
        if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'copy'; e.dataTransfer.setData('text/plain', 'zoom'); }
      });
      el.addEventListener('dragend', () => { draggingCardData = null; });
    }

    /* ---------------- 附加區／展示區 全選拖曳 ---------------- */

    let groupContextSlot = null;
    let groupSelection = null; // { slotId, ids: Set<instanceId> }

    function attachGroupContextMenus() {
      document.querySelectorAll('.attached-container.drop-target, #player-display-front, #player-display-back, #player-discard').forEach(el => {
        el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          const slotId = el.dataset.slot;
          if (!Array.isArray(fieldCards[slotId]) || fieldCards[slotId].length === 0) return;
          showGroupContextMenu(e.clientX, e.clientY, slotId);
        });
      });
      document.addEventListener('click', (e) => {
        const menu = document.getElementById('groupContextMenu');
        if (menu && menu.style.display === 'block' && !menu.contains(e.target)) hideGroupContextMenu();
      });
    }

    function showGroupContextMenu(x, y, slotId) {
      groupContextSlot = slotId;
      const menu = document.getElementById('groupContextMenu');
      menu.style.left = x + 'px';
      menu.style.top = y + 'px';
      menu.style.display = 'block';
    }

    function hideGroupContextMenu() {
      groupContextSlot = null;
      document.getElementById('groupContextMenu').style.display = 'none';
    }

    function selectAllInGroupZone() {
      const slotId = groupContextSlot;
      hideGroupContextMenu();
      const cards = fieldCards[slotId];
      if (!slotId || !Array.isArray(cards) || cards.length === 0) return;
      groupSelection = { slotId, ids: new Set(cards.map(c => c.instanceId)) };
      renderSlot(slotId);
      appendSystemMessage(`已全選 ${cards.length} 張卡牌，可直接拖曳整組移動。`);
    }

    function clearGroupSelection() {
      if (!groupSelection) return;
      const slotId = groupSelection.slotId;
      groupSelection = null;
      renderSlot(slotId);
    }

    // 點擊「牌頂／牌底」格子：把目前全選的卡牌整組移過去，不需要精準拖曳
    function moveGroupSelectionToDeck(position) {
      if (!groupSelection) {
        alert("請先在展示區／附加區／棄牌區按右鍵選擇「全選」，再點擊這裡。");
        return;
      }
      const { slotId, ids } = groupSelection;
      const cards = (fieldCards[slotId] || []).filter(c => ids.has(c.instanceId));
      if (cards.length === 0) { clearGroupSelection(); return; }
      cards.forEach(card => {
        removeFromSource(card, slotId);
        placeCard(card, slotId, position, true);
      });
      clearGroupSelection();
    }

    // interactive=true：玩家自己的區域（可拖曳/點擊）；false：對手區域（唯讀）
    function fillSlot(slotEl, data, slotId, interactive) {
      _fillSlot(slotEl, data, slotId, interactive);
      refreshPointGlow();
      if (typeof renderDamageBars === 'function') renderDamageBars();
    }

    function _fillSlot(slotEl, data, slotId, interactive) {
      if (!slotEl) return;
      slotEl.innerHTML = "";
      slotEl.classList.toggle('is-empty', !data || (Array.isArray(data) && data.length === 0));
      const owner = interactive ? 'me' : 'opp';
      const label = slotId.includes('attached') ? '' : (slotEl.dataset.label || '');

      if (Array.isArray(data)) {
        if (data.length === 0) { slotEl.textContent = label; return; }

        // 棄牌 / 放逐：只顯示最上面一張與張數
        if (slotId === 'discard' || slotId === 'lost') {
          const stack = document.createElement('div');
          stack.className = 'stack-view';
          if (groupSelection && groupSelection.slotId === slotId && groupSelection.ids.size === data.length &&
              data.every(c => groupSelection.ids.has(c.instanceId))) {
            stack.classList.add('is-group-selected');
          }
          const topCard = data[data.length - 1];
          stack.appendChild(makeCardNode(topCard, false));
          const badge = document.createElement('span');
          badge.className = 'count-badge';
          badge.textContent = `×${data.length}`;
          stack.appendChild(badge);
          tagPoint(stack, owner, slotId, data.length - 1);
          stack.addEventListener('click', (e) => onCardClick(e, owner, slotId, data.length - 1, stack));
          if (interactive) {
            // 拖曳最上面一張出來；點擊則開啟檢視面板（可拖曳任意一張）
            stack.draggable = true;
            stack.classList.add('draggable-card');
            stack.addEventListener('dragstart', (e) => startDrag(e, topCard, slotId));
            stack.addEventListener('dragend', () => { draggingCardData = null; });
          } else {
            enableZoomOnlyDrag(stack, topCard, slotId);
          }
          slotEl.appendChild(stack);
          return;
        }

        data.forEach((card) => {
          const item = document.createElement("div");
          item.className = slotId.includes('attached') ? "attached-card-item" : "display-card-item";
          if (groupSelection && groupSelection.slotId === slotId && groupSelection.ids.has(card.instanceId)) {
            item.classList.add('is-group-selected');
          }
          item.appendChild(makeCardNode(card, true));
          const idx = data.indexOf(card);
          tagPoint(item, owner, slotId, idx);
          item.addEventListener('click', (e) => onCardClick(e, owner, slotId, idx, item));

          if (interactive) {
            item.draggable = true;
            item.addEventListener('dragstart', (e) => startDrag(e, card, slotId));
            item.addEventListener('dragend', () => { draggingCardData = null; });
            item.onclick = (e) => { e.stopPropagation(); };
          } else {
            enableZoomOnlyDrag(item, card, slotId);
          }
          slotEl.appendChild(item);
        });
      } else if (data && typeof data === 'object') {
        const cardEl = document.createElement("div");
        cardEl.style.cssText = "width:100%; height:100%;";
        cardEl.appendChild(makeCardNode(data, false));
        tagPoint(cardEl, owner, slotId, 0);
        cardEl.addEventListener('click', (e) => onCardClick(e, owner, slotId, 0, cardEl));

        if (interactive) {
          cardEl.className = "draggable-card";
          cardEl.draggable = true;
          cardEl.addEventListener('dragstart', (e) => startDrag(e, data, slotId));
          cardEl.addEventListener('dragend', () => { draggingCardData = null; });
          cardEl.onclick = (e) => { e.stopPropagation(); };
        } else {
          enableZoomOnlyDrag(cardEl, data, slotId);
        }
        slotEl.appendChild(cardEl);
      } else {
        slotEl.textContent = label;
      }
    }

    function renderPlayerHand() {
      const handEl = document.getElementById("player-hand");
      handEl.innerHTML = "";

      if (playerHand.length === 0) {
        const empty = document.createElement('div');
        empty.style.cssText = "color:#aaa; font-size:0.75rem;";
        empty.textContent = "手牌區無卡牌";
        handEl.appendChild(empty);
        return;
      }

      playerHand.forEach((card) => {
        const slot = document.createElement("div");
        slot.className = "card-slot draggable-card";
        slot.draggable = true;
        slot.appendChild(makeCardNode({ ...card, isFaceDown: false }, false));

        slot.addEventListener('dragstart', (e) => startDrag(e, card, 'hand'));
        slot.addEventListener('dragend', () => { draggingCardData = null; });
        handEl.appendChild(slot);
      });
      broadcastHandCount();
    }

    function broadcastHandCount() {
      if (conn && conn.open) conn.send({ type: 'hand_update', count: playerHand.length });
    }

    function updateOpponentHandUI(count) {
      const oppHandEl = document.getElementById("opponent-hand");
      oppHandEl.innerHTML = "";
      const t = document.createElement('div');
      t.style.cssText = "color:#ffd700; font-size:0.75rem;";
      t.textContent = `對手手牌數：${count} 張`;
      oppHandEl.appendChild(t);
    }

    /* ---------------- 聊天 ---------------- */

    function appendSystemMessage(msg) {
      const box = document.getElementById("chat-messages");
      const div = document.createElement("div");
      div.className = "message system";
      div.textContent = `[系統] ${msg}`;
      box.appendChild(div);
      box.scrollTop = box.scrollHeight;
    }

    function appendChatMessage(sender, msg) {
      const box = document.getElementById("chat-messages");
      const div = document.createElement("div");
      div.className = "message";
      div.textContent = `${sender}: ${msg}`;
      box.appendChild(div);
      box.scrollTop = box.scrollHeight;
    }

    function sendChatMessage() {
      const input = document.getElementById("chatInput");
      const text = input.value.trim();
      if (!text) return;

      appendChatMessage("我", text);
      if (conn && conn.open) conn.send({ type: 'chat', message: text });
      input.value = "";
    }

    function leaveRoom() {
      if (confirm("確定要離開房間嗎？")) {
        if (conn) conn.close();
        if (peer) peer.destroy();
        window.location.href = "index.html";
      }
    }

    window.onload = initDeckSelection;
  </script>
</body>
</html>
