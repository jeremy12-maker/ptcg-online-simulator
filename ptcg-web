  <div id="renameCardModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <h3>更改卡牌名稱</h3>
      <div>
        <label style="display:block; margin-bottom:6px;">新的卡牌名稱：</label>
        <input type="text" id="renameCardInput" class="text-input" style="width:100%;" onkeydown="if(event.key==='Enter') saveRenameCard(); if(event.key==='Escape') closeRenameModal();">
      </div>
      <div style="display: flex; gap: 10px; margin-top: 10px;">
        <button class="btn-action" style="flex:1;" onclick="saveRenameCard()">儲存</button>
        <button class="btn-clear-all" style="flex:1;" onclick="closeRenameModal()">取消</button>
      </div>
    </div>
  </div>

  <!-- 新建牌組檔案 Modal -->
  <div id="createDeckModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <h3>建立新牌組檔案</h3>
      <div>
        <label style="display:block; margin-bottom:6px;">牌組名稱：</label>
        <input type="text" id="deckNameInput" class="text-input" placeholder="例如：皮卡丘 EX 快速組" style="width:100%;">
      </div>
      <div>
        <label style="display:block; margin-bottom:6px;">卡牌張數上限：</label>
        <input type="number" id="deckLimitInput" class="text-input" value="60" style="width:100%;">
      </div>

      <div style="display: flex; gap: 10px; margin-top: 10px;">
        <button class="btn-action" style="flex:1;" onclick="createDeckFile()">建立檔案</button>
        <button class="btn-clear-all" style="flex:1;" onclick="closeCreateDeckModal()">取消</button>
      </div>
    </div>
  </div>

  <script>
    // ===== IndexedDB 卡牌資料庫 (與 index.html 共用同一個資料庫) =====
    const DB_NAME = "ptcg_db", CARD_STORE = "cards";
    function openDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = () => req.result.createObjectStore(CARD_STORE, { keyPath: "id" });
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }
    async function dbGetAllCards() {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const req = db.transaction(CARD_STORE, "readonly").objectStore(CARD_STORE).getAll();
        req.onsuccess = () => resolve(req.result || []);
        req.onerror = () => reject(req.error);
      });
    }
    async function dbPutCard(card) {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(CARD_STORE, "readwrite");
        tx.objectStore(CARD_STORE).put(card);
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject(tx.error);
      });
    }
    async function dbDeleteCard(id) {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(CARD_STORE, "readwrite");
        tx.objectStore(CARD_STORE).delete(id);
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject(tx.error);
      });
    }
    async function dbClearCards() {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(CARD_STORE, "readwrite");
        tx.objectStore(CARD_STORE).clear();
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject(tx.error);
      });
    }
    // 舊版卡牌存在 localStorage，一次性搬到 IndexedDB
    async function migrateOldCards() {
      try {
        const old = JSON.parse(localStorage.getItem("custom_cards"));
        if (Array.isArray(old) && old.length) {
          for (const c of old) await dbPutCard(c);
        }
        localStorage.removeItem("custom_cards");
      } catch (e) { console.warn("舊資料搬移失敗", e); }
    }

    let cardCache = []; // 目前卡牌庫快取 (供牌組編輯器查詢)
    let currentEditingDeckId = null;
    let currentEditingDeckMaxLimit = 60; // 修正1: 記住目前編輯牌組的實際上限
    let editingDeckCardsMap = new Map(); // cardId -> { card, count }

    // 主分頁切換
    function switchWarehouseTab(tabName, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.sub-tab-btn').forEach(el => el.classList.remove('active'));

      document.getElementById(`tab-${tabName}`).classList.add('active');
      if (btn) btn.classList.add('active');

      if (tabName === 'cards') renderWarehouseCards();
      if (tabName === 'decks') renderWarehouseDecks();
    }

    // 1. 渲染單卡庫
    async function renderWarehouseCards() {
      const cardGrid = document.getElementById("cardGrid");
      const filterType = document.getElementById("typeFilter").value;
      const storedCards = await dbGetAllCards();

      cardGrid.innerHTML = "";
      const filteredCards = storedCards.filter(card => filterType === "all" || card.type === filterType);

      if (filteredCards.length === 0) {
        cardGrid.innerHTML = `<div class="empty-msg"><h3>單卡庫無卡牌</h3><p>可前往「新增卡牌」頁面建立單卡資料。</p></div>`;
        return;
      }

      filteredCards.forEach(card => {
        const cardEl = document.createElement("div");
        cardEl.className = "card-item";

        let typeBadgeClass = "badge-pokemon", typeName = "寶可夢";
        if (card.type === "trainer") { typeBadgeClass = "badge-trainer"; typeName = "訓練家"; }
        if (card.type === "energy") { typeBadgeClass = "badge-energy"; typeName = "能量"; }

        cardEl.innerHTML = `
          <span class="card-badge ${typeBadgeClass}">${typeName}</span>
          <div class="card-img-wrapper">
            <img src="${card.image}" alt="${card.name}" onerror="this.src='https://via.placeholder.com/150x210?text=無圖片'">
          </div>
          <div class="card-name">${card.name}</div>
          <div class="card-action-bar">
            <button class="btn-qty-control btn-rename" onclick="openRenameModal('${card.id}')">✏️ 改名</button>
            <button class="btn-qty-control btn-qty-sub" onclick="deleteCard('${card.id}')">刪除</button>
          </div>
        `;
        cardGrid.appendChild(cardEl);
      });
    }

    // 2. 渲染牌組檔案庫 (檔案卡片)
    function renderWarehouseDecks() {
      const deckGrid = document.getElementById("deckFolderGrid");
      const storedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];

      deckGrid.innerHTML = "";

      if (storedDecks.length === 0) {
        deckGrid.innerHTML = `<div class="empty-msg"><h3>尚無牌組檔案</h3><p>點擊右上角「＋ 建立新牌組檔案」開始建檔。</p></div>`;
        return;
      }

      storedDecks.forEach((deck) => {
        const totalCards = (deck.cards || []).reduce((sum, item) => sum + (item.count || 1), 0);
        const deckEl = document.createElement("div");
        deckEl.className = "deck-folder-card";

        deckEl.innerHTML = `
          <div class="deck-folder-header">
            <div class="deck-folder-title">📁 ${deck.name}</div>
            <div class="deck-folder-stats">${totalCards} / ${deck.maxLimit || 60} 張</div>
          </div>
          <button class="btn-enter-deck" onclick="openDeckEditor('${deck.id}')">📂 進入牌組檔案內容</button>
          <button class="btn-clear-all" style="font-size:0.8rem; padding:4px;" onclick="deleteDeckFile('${deck.id}')">刪除檔案</button>
        `;
        deckGrid.appendChild(deckEl);
      });
    }

    // Modal 新建檔案邏輯
    function openCreateDeckModal() {
      document.getElementById("deckNameInput").value = "";
      document.getElementById("createDeckModal").style.display = "flex";
    }
    function closeCreateDeckModal() {
      document.getElementById("createDeckModal").style.display = "none";
    }

    function createDeckFile() {
      const name = document.getElementById("deckNameInput").value.trim();
      const limit = parseInt(document.getElementById("deckLimitInput").value) || 60;
      if (!name) { alert("請輸入牌組檔案名稱！"); return; }

      const newDeck = {
        id: "deck_" + Date.now(),
        name: name,
        maxLimit: limit,
        cards: []
      };

      let storedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
      storedDecks.push(newDeck);
      localStorage.setItem("custom_decks", JSON.stringify(storedDecks));

      closeCreateDeckModal();
      renderWarehouseDecks();
    }

    // 進入牌組檔案內部編輯 (左右雙欄模式)
    async function openDeckEditor(deckId) {
      const storedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
      const deck = storedDecks.find(d => d.id === deckId);
      if (!deck) return;

      currentEditingDeckId = deckId;
      currentEditingDeckMaxLimit = deck.maxLimit || 60; // 修正1: 讀取此牌組真正的上限
      document.getElementById("currentEditingDeckTitle").innerText = `📁 編輯檔案：${deck.name}`;

      // 初始化 Map：牌組只存 {id, count}，圖片等資料從卡牌庫查詢
      cardCache = await dbGetAllCards();
      editingDeckCardsMap.clear();
      (deck.cards || []).forEach(item => {
        const full = cardCache.find(c => c.id === item.id) || (item.image ? item : null); // 相容舊版牌組
        if (full) editingDeckCardsMap.set(item.id, { card: full, count: item.count || 1 });
      });

      // 切換視窗
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.getElementById('tab-deck-editor').classList.add('active');

      renderLeftCardPicker();
      renderRightDeckList();
    }

    // 渲染左側：卡牌清單庫 (配有加一張/減一張)
    function renderLeftCardPicker() {
      const pickerGrid = document.getElementById("editorCardPickerGrid");
      const storedCards = cardCache;
      pickerGrid.innerHTML = "";

      if (storedCards.length === 0) {
        pickerGrid.innerHTML = `<div class="empty-msg"><p>卡牌倉庫中目前沒有任何卡牌可選。</p></div>`;
        return;
      }

      storedCards.forEach(card => {
        const cardEl = document.createElement("div");
        cardEl.className = "card-item";

        cardEl.innerHTML = `
          <div class="card-img-wrapper">
            <img src="${card.image}" alt="${card.name}">
          </div>
          <div class="card-name">${card.name}</div>
          <div class="card-action-bar">
            <button class="btn-qty-control btn-qty-add" onclick="adjustCardQty('${card.id}', 1)">加一張</button>
            <button class="btn-qty-control btn-qty-sub" onclick="adjustCardQty('${card.id}', -1)">減一張</button>
          </div>
        `;
        pickerGrid.appendChild(cardEl);
      });
    }

    // 調整卡牌數量 (加一張 / 減一張)
    function adjustCardQty(cardId, delta) {
      const card = cardCache.find(c => c.id === cardId);

      // 修正2: 加卡前檢查是否已達牌組上限
      if (delta > 0) {
        let currentTotal = 0;
        editingDeckCardsMap.forEach(item => currentTotal += item.count);
        if (currentTotal >= currentEditingDeckMaxLimit) {
          alert(`牌組已達上限 ${currentEditingDeckMaxLimit} 張，無法再新增！`);
          return;
        }
      }

      if (!editingDeckCardsMap.has(cardId)) {
        if (delta > 0 && card) {
          editingDeckCardsMap.set(cardId, { card: { ...card }, count: 1 });
        }
      } else {
        const item = editingDeckCardsMap.get(cardId);
        item.count += delta;
        if (item.count <= 0) {
          editingDeckCardsMap.delete(cardId);
        }
      }

      renderRightDeckList();
    }

    // 渲染右側：當前牌組內容
    // 渲染右側：當前牌組內容 (包含圖片預覽)
function renderRightDeckList() {
  const deckList = document.getElementById("deckCardsList");
  const countBadge = document.getElementById("deckCardCountBadge");
  deckList.innerHTML = "";

  let totalCount = 0;

  if (editingDeckCardsMap.size === 0) {
    deckList.innerHTML = `<div class="empty-msg" style="grid-column: 1 / -1;"><p>牌組內目前沒有卡牌<br>點選左側卡牌「加一張」即可加入</p></div>`;
  } else {
    editingDeckCardsMap.forEach((item, cardId) => {
      totalCount += item.count;

      // 類型標籤設定
      let typeBadgeClass = "badge-pokemon", typeName = "寶可夢";
      if (item.card.type === "trainer") { typeBadgeClass = "badge-trainer"; typeName = "訓練家"; }
      if (item.card.type === "energy") { typeBadgeClass = "badge-energy"; typeName = "能量"; }

      const itemEl = document.createElement("div");
      itemEl.className = "card-item";
      itemEl.style.borderColor = "#00d2ff"; // 以藍色邊框強調屬於右側當前牌組

      itemEl.innerHTML = `
        <span class="card-badge ${typeBadgeClass}">${typeName}</span>
        <!-- 張數顯示標籤 -->
        <span style="position: absolute; top: 8px; right: 8px; background: #00d2ff; color: #121218; font-weight: bold; font-size: 0.75rem; padding: 2px 7px; border-radius: 10px; z-index: 2;">
          ${item.count} 張
        </span>
        <div class="card-img-wrapper">
          <img src="${item.card.image}" alt="${item.card.name}" onerror="this.src='https://via.placeholder.com/150x210?text=無圖片'">
        </div>
        <div class="card-name">${item.card.name}</div>
        <div class="card-action-bar">
          <button class="btn-qty-control btn-qty-add" onclick="adjustCardQty('${cardId}', 1)">＋</button>
          <button class="btn-qty-control btn-qty-sub" onclick="adjustCardQty('${cardId}', -1)">－</button>
        </div>
      `;
      deckList.appendChild(itemEl);
    });
  }

  // 修正1: 顯示這個牌組真正的上限，而不是寫死的 60
  countBadge.innerText = `${totalCount} / ${currentEditingDeckMaxLimit} 張`;
}

    // 儲存變更
    function saveCurrentDeck() {
      let storedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
      const deckIndex = storedDecks.findIndex(d => d.id === currentEditingDeckId);

      if (deckIndex !== -1) {
        const updatedCards = [];
        editingDeckCardsMap.forEach(item => {
          updatedCards.push({ id: item.card.id, count: item.count }); // 只存參照，不重複存圖片
        });

        storedDecks[deckIndex].cards = updatedCards;
        localStorage.setItem("custom_decks", JSON.stringify(storedDecks));
      }

      exitDeckEditor();
    }

    function exitDeckEditor() {
      currentEditingDeckId = null;
      editingDeckCardsMap.clear();
      switchWarehouseTab('decks', document.querySelectorAll('.sub-tab-btn')[1]);
    }

    // 刪除邏輯
    // 更改卡牌名稱（牌組只存卡牌 id，所以所有牌組會自動顯示新名稱）
    let renameTargetId = null;

    async function openRenameModal(cardId) {
      const cards = await dbGetAllCards();
      const card = cards.find(c => c.id === cardId);
      if (!card) return;
      renameTargetId = cardId;
      const input = document.getElementById("renameCardInput");
      input.value = card.name;
      document.getElementById("renameCardModal").style.display = "flex";
      input.focus();
      input.select();
    }

    function closeRenameModal() {
      renameTargetId = null;
      document.getElementById("renameCardModal").style.display = "none";
    }

    async function saveRenameCard() {
      const newName = document.getElementById("renameCardInput").value.trim();
      if (!newName) { alert("請輸入卡牌名稱！"); return; }

      const cards = await dbGetAllCards();
      const card = cards.find(c => c.id === renameTargetId);
      if (!card) { closeRenameModal(); return; }

      card.name = newName;
      try {
        await dbPutCard(card);
      } catch (e) {
        console.error(e);
        alert("儲存失敗，請稍後再試。");
        return;
      }
      closeRenameModal();
      renderWarehouseCards();
    }

    async function deleteCard(cardId) {
      if (confirm("確定要刪除這張單卡嗎？")) {
        await dbDeleteCard(cardId);
        renderWarehouseCards();
      }
    }

    function deleteDeckFile(deckId) {
      if (confirm("確定要刪除此牌組檔案嗎？")) {
        let storedDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
        storedDecks = storedDecks.filter(d => d.id !== deckId);
        localStorage.setItem("custom_decks", JSON.stringify(storedDecks));
        renderWarehouseDecks();
      }
    }

    async function clearAllCards() {
      if (confirm("確定要清空單卡庫嗎？")) {
        await dbClearCards();
        renderWarehouseCards();
      }
    }

    // 匯出全部資料（卡牌圖片 + 牌組）成一個 JSON 檔，供傳到別的裝置匯入
    async function exportAllData() {
      try {
        const cards = await dbGetAllCards();
        const decks = JSON.parse(localStorage.getItem("custom_decks")) || [];
        const payload = {
          type: "ptcg-backup",
          exportedAt: new Date().toISOString(),
          cards, decks
        };
        const blob = new Blob([JSON.stringify(payload)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        const dateStr = new Date().toISOString().slice(0, 10);
        a.href = url;
        a.download = `ptcg-backup-${dateStr}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } catch (e) {
        console.error(e);
        alert("匯出失敗，請稍後再試。");
      }
    }

    // 匯入備份檔：卡牌用 id 覆蓋/新增，牌組同樣用 id 比對，避免重複
    async function importAllData(event) {
      const file = event.target.files[0];
      event.target.value = ""; // 清空，允許下次選同一個檔案也能觸發 change
      if (!file) return;

      let payload;
      try {
        const text = await file.text();
        payload = JSON.parse(text);
      } catch (e) {
        alert("這個檔案看起來不是有效的備份檔。");
        return;
      }
      if (!payload || payload.type !== "ptcg-backup" || !Array.isArray(payload.cards)) {
        alert("這個檔案看起來不是有效的備份檔。");
        return;
      }

      const cardCount = payload.cards.length;
      const deckCount = Array.isArray(payload.decks) ? payload.decks.length : 0;
      if (!confirm(`即將匯入 ${cardCount} 張卡牌、${deckCount} 個牌組。
同樣 ID 的卡牌/牌組會被覆蓋，其餘會新增進來。確定要匯入嗎？`)) {
        return;
      }

      try {
        for (const card of payload.cards) {
          if (card && card.id) await dbPutCard(card);
        }
        if (Array.isArray(payload.decks)) {
          let existingDecks = JSON.parse(localStorage.getItem("custom_decks")) || [];
          const deckMap = new Map(existingDecks.map(d => [d.id, d]));
          payload.decks.forEach(d => { if (d && d.id) deckMap.set(d.id, d); });
          localStorage.setItem("custom_decks", JSON.stringify(Array.from(deckMap.values())));
        }
        alert(`匯入完成！已匯入 ${cardCount} 張卡牌、${deckCount} 個牌組。`);
        renderWarehouseCards();
      } catch (e) {
        console.error(e);
        alert("匯入過程發生錯誤，部分資料可能未完成匯入。");
      }
    }

    document.addEventListener("DOMContentLoaded", async () => { await migrateOldCards(); renderWarehouseCards(); });
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PTCG 遊戲系統 - 大廳</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #121218; color: #e0e0e0;
      font-family: Arial, "PingFang TC", "Microsoft JhengHei", sans-serif;
      min-height: 100vh; display: flex; flex-direction: column;
    }

    /* 頂部導覽列 (已移除獨立牌組頁，統一標籤樣式) */
    .navbar {
      background: #1a1a24; border-bottom: 2px solid #3d3d4e;
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 24px; height: 60px; position: sticky; top: 0; z-index: 100;
    }
    .nav-logo { font-size: 1.2rem; font-weight: bold; color: #ffd700; letter-spacing: 1px; }
    .nav-tabs { display: flex; gap: 8px; height: 100%; }
    .nav-btn {
      background: transparent; border: none; color: #a0a0b0;
      font-size: 0.95rem; font-weight: bold; padding: 0 20px;
      cursor: pointer; display: flex; align-items: center; gap: 8px;
      transition: all 0.2s ease; border-bottom: 3px solid transparent; text-decoration: none;
    }
    .nav-btn:hover { color: #ffffff; background: rgba(255, 255, 255, 0.03); }
    .nav-btn.active { color: #00d2ff; border-bottom-color: #00d2ff; background: rgba(0, 210, 255, 0.05); }

    /* 內容主區域 */
    .main-content { flex: 1; padding: 20px; display: flex; justify-content: center; }
    .tab-pane { display: none; width: 100%; max-width: 1200px; }
    .tab-pane.active { display: flex; flex-direction: column; gap: 20px; }

    /* 通用卡片與大廳樣式 */
    .content-card {
      background: #1e1e26; border: 2px solid #3d3d4e;
      border-radius: 12px; padding: 24px; box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }
    .lobby-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 20px; }
    .lobby-card {
      background: rgba(255, 255, 255, 0.02); border: 1.5px solid #3d3d4e;
      border-radius: 12px; padding: 24px; display: flex; flex-direction: column;
      gap: 16px; align-items: center; text-align: center;
    }
    .lobby-card h3 { color: #00d2ff; font-size: 1.2rem; }

    .btn-primary {
      background: #00d2ff; color: #121218; border: none; padding: 12px 24px;
      border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: all 0.2s; width: 100%;
    }
    .btn-primary:hover { background: #33e0ff; box-shadow: 0 0 15px rgba(0, 210, 255, 0.4); }

    .btn-success {
      background: #2ed573; color: #121218; border: none; padding: 12px 24px;
      border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: all 0.2s; width: 100%;
    }
    .btn-success:hover { background: #55efc4; box-shadow: 0 0 15px rgba(46, 213, 115, 0.4); }

    .btn-add-card {
      background: #ffd700; color: #121218; border: none; padding: 12px 24px;
      border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 15px; font-size: 1rem;
      transition: all 0.2s;
    }
    .btn-add-card:hover { background: #ffeaa7; box-shadow: 0 0 15px rgba(255, 215, 0, 0.4); }

    .form-control {
      background: rgba(0,0,0,0.3); border: 1px solid #444455; border-radius: 6px;
      padding: 12px; color: #fff; outline: none; width: 100%; text-align: center; font-size: 1rem;
    }
    .status-text { font-size: 0.9rem; color: #aaa; }

    /* Modal 彈出視窗樣式 */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0,0,0,0.75); display: flex; align-items: center; justify-content: center;
      z-index: 1000;
    }
    .modal-content {
      background: #1e1e26; border: 2px solid #3d3d4e; border-radius: 12px;
      padding: 24px; width: 90%; max-width: 450px; display: flex; flex-direction: column; gap: 12px;
    }
    .modal-content input, .modal-content select {
      background: rgba(0,0,0,0.4); border: 1px solid #444; border-radius: 6px;
      padding: 8px 12px; color: #fff; outline: none; width: 100%;
    }
    .modal-actions { display: flex; gap: 10px; margin-top: 10px; }
    .btn-confirm { background: #2ed573; color: #121218; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; flex: 1; }
    .btn-cancel { background: #ff4757; color: #fff; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; flex: 1; }
  </style>
</head>
<body>

  <!-- 頂部導覽列 (已精簡為三個核心分頁，風格完全統一) -->
  <nav class="navbar">
    <div class="nav-logo">PTCG SIMULATOR</div>
    <div class="nav-tabs">
      <button class="nav-btn active" data-tab="battle" onclick="switchTab('battle', this)">⚔️ 對戰</button>
      <button class="nav-btn" data-tab="add-card" onclick="switchTab('add-card', this)">➕ 新增卡牌</button>
      <a href="card-warehouse.html" class="nav-btn">📦 卡牌倉庫</a>
    </div>
  </nav>

  <main class="main-content">
    
    <!-- 1. 對戰大廳頁面 -->
    <div id="tab-battle" class="tab-pane active">
      <div class="content-card">
        <h2>連線對戰大廳</h2>
        <p style="color: #aaa; margin-top: 6px;">創建房間邀請朋友，或輸入對方的房間 ID 開始連線對戰。</p>
        
        <div class="lobby-container">
          <!-- 創建房間 -->
          <div class="lobby-card">
            <h3>🏠 創建房間 (房主)</h3>
            <p class="status-text">生成對戰房間 ID 並進入對戰區</p>
            <button class="btn-primary" onclick="createRoom()">創建房間並進入</button>
          </div>

          <!-- 加入房間 -->
          <div class="lobby-card">
            <h3>🔗 加入房間 (挑戰者)</h3>
            <p class="status-text">請輸入房主提供的房間 ID</p>
            <input type="text" id="join-room-input" class="form-control" placeholder="例如：PTCG-X8K2M1">
            <button class="btn-success" onclick="joinRoom()">進入房間對戰</button>
            <p id="join-status" class="status-text" style="color: #ff4757;"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. 新增卡牌頁面 -->
    <div id="tab-add-card" class="tab-pane">
      <div class="content-card">
        <h2>新增自訂卡牌</h2>
        <p style="color: #aaa; margin-top: 6px; margin-bottom: 12px;">點擊下方按鈕上傳或建立新的卡牌資料。</p>
        <button class="btn-add-card" onclick="openAddCardModal()">＋ 新增卡牌</button>
      </div>
    </div>
  </main>

  <!-- 新增卡牌的彈出視窗 (Modal) -->
  <div id="addCardModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div id="addCardFormView">
        <h3>新增卡牌至倉庫資料庫</h3>

        <label>卡牌名稱：</label>
        <input type="text" id="cardNameInput" placeholder="請輸入卡牌名稱 (例如: 皮卡丘)" />

        <label>卡牌類型：</label>
        <select id="cardTypeSelect">
          <option value="pokemon">寶可夢</option>
          <option value="trainer">訓練家</option>
          <option value="energy">能量卡</option>
        </select>

        <label>選擇圖片來源：</label>
        <div class="input-group">
          <input type="file" id="cardFileInput" accept="image/*" onchange="handleFileSelect(event)">
          <p style="font-size: 0.8rem; color: #888; margin-top: 5px;">或輸入雲端圖片網址 (URL)：</p>
          <input type="url" id="cardUrlInput" placeholder="https://example.com/card.png" oninput="handleUrlInput(event)">
        </div>

        <!-- 圖片預覽區域 -->
        <div class="image-preview-container" style="text-align: center;">
          <img id="cardPreview" src="" alt="圖片預覽" style="display:none; max-width: 150px; margin-top: 10px; border-radius: 8px;">
        </div>

        <div class="modal-actions">
          <button onclick="saveNewCard()" class="btn-confirm">儲存並存入倉庫</button>
          <button onclick="closeAddCardModal()" class="btn-cancel">取消</button>
        </div>
      </div>

      <!-- 新增成功提示畫面 -->
      <div id="addCardSuccessView" style="display:none; text-align:center; padding: 24px 0;">
        <div style="font-size:3rem;">✅</div>
        <p style="font-size:1.15rem; font-weight:bold; color:#2ed573; margin-top:12px;">新增成功！</p>
        <p id="addCardSuccessName" style="color:#aaa; margin-top:6px; font-size:0.9rem;"></p>
      </div>
    </div>
  </div>

  <script>
    // ===== IndexedDB 卡牌資料庫 (容量遠大於 localStorage，可存大量卡圖) =====
    const DB_NAME = "ptcg_db", CARD_STORE = "cards";
    function openDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = () => req.result.createObjectStore(CARD_STORE, { keyPath: "id" });
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }
    async function dbPutCard(card) {
      const db = await openDB();
      return new Promise((resolve, reject) => {
        const tx = db.transaction(CARD_STORE, "readwrite");
        tx.objectStore(CARD_STORE).put(card);
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject(tx.error);
        tx.onabort = () => reject(tx.error);
      });
    }
    // 一次性把舊版存在 localStorage 的卡牌搬到 IndexedDB
    async function migrateOldCards() {
      try {
        const old = JSON.parse(localStorage.getItem("custom_cards"));
        if (Array.isArray(old) && old.length) {
          for (const c of old) await dbPutCard(c);
        }
        localStorage.removeItem("custom_cards");
      } catch (e) { console.warn("舊資料搬移失敗", e); }
    }
    // 請瀏覽器將此網站的資料標記為「持久保存」，避免空間不足時被自動清除
    if (navigator.storage && navigator.storage.persist) navigator.storage.persist();
    migrateOldCards();

    let currentCardImageData = "";
    let currentImageSource = ""; // 修正: 記錄目前圖片來源是 "file" 還是 "url"

    // 切換分頁
    function switchTab(tabName, btnElement) {
      document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      
      const targetPane = document.getElementById(`tab-${tabName}`);
      if (targetPane) targetPane.classList.add('active');
      if (btnElement) btnElement.classList.add('active');
    }

    // 從其他頁面(如卡牌倉庫)連結過來時，依網址 ?tab= 參數開啟對應分頁
    function initTabFromUrl() {
      const tab = new URLSearchParams(window.location.search).get('tab');
      if (!tab) return;
      const btn = document.querySelector(`.nav-btn[data-tab="${tab}"]`);
      if (btn) switchTab(tab, btn);
    }
    initTabFromUrl();

    // 房間連線邏輯
    function createRoom() {
      const roomId = 'PTCG-' + Math.random().toString(36).substring(2, 8).toUpperCase();
      window.location.href = `battle.html?roomId=${roomId}&isHost=true`;
    }

    function joinRoom() {
      const roomId = document.getElementById('join-room-input').value.trim();
      if (!roomId) {
        document.getElementById('join-status').innerText = '請輸入房間 ID！';
        return;
      }
      window.location.href = `battle.html?roomId=${roomId}&isHost=false`;
    }

    // Modal 與卡牌儲存邏輯
    function openAddCardModal() {
      document.getElementById("addCardModal").style.display = "flex";
    }

    function closeAddCardModal() {
      document.getElementById("addCardModal").style.display = "none";
      resetAddCardForm();
    }

    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (file) {
        document.getElementById("cardUrlInput").value = ""; // 清空 URL 欄位
        const reader = new FileReader();
        reader.onload = async function (e) {
          // 修正: 先壓縮圖片再存，避免原始高解析度卡圖很快把 localStorage 塞爆
          currentCardImageData = await compressImage(e.target.result);
          currentImageSource = "file"; // 標記來源為檔案上傳
          updatePreview(currentCardImageData);
        };
        reader.readAsDataURL(file);
      }
    }

    // 將圖片縮小並轉成品質 0.75 的 JPEG，大幅降低 localStorage 佔用空間
    function compressImage(dataUrl, maxDimension = 500, quality = 0.75) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          let { width, height } = img;
          if (width > maxDimension || height > maxDimension) {
            if (width > height) {
              height = Math.round(height * (maxDimension / width));
              width = maxDimension;
            } else {
              width = Math.round(width * (maxDimension / height));
              height = maxDimension;
            }
          }
          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL("image/jpeg", quality));
        };
        img.onerror = () => resolve(dataUrl); // 壓縮失敗就退回原圖，不擋住使用者
        img.src = dataUrl;
      });
    }

    function handleUrlInput(event) {
      const url = event.target.value.trim();
      if (url) {
        document.getElementById("cardFileInput").value = ""; // 清空檔案選擇器
        currentCardImageData = url;
        currentImageSource = "url"; // 修正: 標記來源為網址輸入
        updatePreview(url);
      } else if (currentImageSource === "url") {
        // 修正: 只有原本就是靠網址輸入設定的圖片，欄位清空才跟著清掉；
        // 不會誤刪使用者已透過檔案上傳選好的圖片
        document.getElementById("cardPreview").style.display = "none";
        currentCardImageData = "";
        currentImageSource = "";
      }
    }

    function updatePreview(src) {
      const preview = document.getElementById("cardPreview");
      if (preview) {
        preview.src = src;
        preview.style.display = "inline-block";
      }
    }

    // 儲存卡牌到倉庫 (LocalStorage)
    async function saveNewCard() {
      const cardName = document.getElementById("cardNameInput").value.trim();
      const cardType = document.getElementById("cardTypeSelect").value;
      const urlInput = document.getElementById("cardUrlInput").value.trim();

      if (urlInput) {
        currentCardImageData = urlInput;
      }

      if (!cardName) {
        alert("請輸入卡牌名稱！");
        return;
      }

      if (!currentCardImageData) {
        alert("請選擇圖片檔案或輸入圖片網址！");
        return;
      }

      const newCard = {
        id: "card_" + Date.now() + "_" + Math.random().toString(36).substring(2, 6), // 修正: 加上隨機尾碼避免同毫秒 ID 撞號
        name: cardName,
        type: cardType,
        image: currentCardImageData
      };

      try {
        await dbPutCard(newCard);
      } catch (e) {
        console.error(e);
        alert("儲存失敗：瀏覽器儲存空間不足或被限制，請確認磁碟空間，或改用本機伺服器/網站方式開啟。");
        return;
      }

      showAddCardSuccess(cardName);
    }

    // 顯示「新增成功」畫面，短暫停留後自動關閉 Modal
    function showAddCardSuccess(cardName) {
      document.getElementById("addCardFormView").style.display = "none";
      document.getElementById("addCardSuccessView").style.display = "block";
      document.getElementById("addCardSuccessName").innerText = `「${cardName}」已加入卡牌單卡庫`;

      setTimeout(() => {
        closeAddCardModal();
      }, 1200);
    }

    function resetAddCardForm() {
      document.getElementById("cardNameInput").value = "";
      document.getElementById("cardFileInput").value = "";
      document.getElementById("cardUrlInput").value = "";
      document.getElementById("cardPreview").style.display = "none";
      currentCardImageData = "";
      currentImageSource = "";

      // 還原顯示表單、隱藏成功畫面，供下次開啟 Modal 使用
      document.getElementById("addCardFormView").style.display = "block";
      document.getElementById("addCardSuccessView").style.display = "none";
    }
  </script>
</body>
</html>
